# 飞书录入 POC 测试环境配置示例。
# 复制为 test.env 后填写真实值；真实 test.env 不要提交。

# 飞书自建应用凭证。
# 这里配置的是“应用身份”，不是某个多维表格。
# 程序会用 App ID / App Secret 自动获取 tenant_access_token。
# 只要这个应用被加入对应多维表格并拥有权限，就可以读取/写入多维表格。
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# POC 默认执行的飞书录入节点。
# 来源多维表 app_token/table_id 已经放在节点目录的 node.yaml 中管理，
# 不再放到 .env。
FEISHU_NODE_CODE=product_intake_poc

# 可选：指定节点内要执行的任务。
# 留空时默认选择 node.yaml 中第一个启用任务。
# 当前 POC 示例：incremental=增量同步，reconcile=兜底校准。
FEISHU_TASK_CODE=

# 可选：节点配置根目录。
# 不填时默认使用 configs/feishu_nodes。
FEISHU_NODE_CONFIG_ROOT=

# 可选：临时覆盖来源飞书视图 ID。
# 长期固定视图建议配置在节点目录 node.yaml 的 source.view_id。
FEISHU_VIEW_ID=

# 可选：临时飞书 API 原生过滤表达式。
# 留空时使用当前任务的 node.yaml tasks[].read_filter。
# 适合临时调试；长期固定过滤条件建议写在 node.yaml 的任务配置里。
FEISHU_FILTER=

# PostgreSQL 测试库连接串。
# 示例格式：
# postgresql://user:password@host:port/database
DATABASE_URL=

# 可选：POC 建表 SQL 路径。
# 留空时使用 apps/feishu_intake_poc/sql/001_create_poc_tables.sql。
POC_SQL_PATH=

# 可选：飞书通知配置。
# 配置后，主流程结束时可以发送同步摘要消息。
FEISHU_NOTIFICATION_RECEIVE_ID=
FEISHU_NOTIFICATION_RECEIVE_ID_TYPE=chat_id